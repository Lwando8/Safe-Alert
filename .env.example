# CLERK CONFIGURATION
# Canonical mobile/web Clerk application: Seren SOS (real-guppy-12).
# Do not use Seren SOS Platform (expert-drake-16) for this app’s keys.
# Dashboard: https://dashboard.clerk.com/

# Required for Expo
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Enable unified Clerk mobile login (identity → Person → membership → experience)
# EXPO_PUBLIC_ENABLE_CLERK_MOBILE=true

# Optional escape hatch to show legacy Express citizen/responder login after Clerk is enabled
# EXPO_PUBLIC_ALLOW_LEGACY_EXPRESS_LOGIN=true

# Express SOS compatibility after Clerk auth (pairs with server EXPRESS_CLERK_COMPAT_SECRET
# or MOBILE_BRIDGE_MINT_SECRET). Required for SOS without a second Express login.
# EXPO_PUBLIC_EXPRESS_CLERK_COMPAT_SECRET=seren_local_express_compat_dev_only

# --- Device lab networking ---
# Preferred one-command labs (auto seed phase2b; optional --seed-clerk-user):
#   npm run lab        # LAN / iPhone — writes .env.local hosts to detected Wi‑Fi IP
#   npm run lab:usb    # Android USB — adb reverse + Expo --localhost
# Templates: .env.local.lan  .env.local.usb
# Avoid Expo --tunnel for bridge testing (tunnel only carries the JS bundle).
#
# Manual LAN overrides (same Wi‑Fi, no AP/guest isolation):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:4000
# EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=192.168.x.x:5001
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=192.168.x.x:9099

# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-seren
# EXPO_PUBLIC_GCLOUD_PROJECT=demo-seren

# Bridge mint for emulator / device-lab golden path (pairs with functions MOBILE_BRIDGE_MINT_SECRET)
# Never commit real secrets. Never enable operator mint in production builds.
# EXPO_PUBLIC_MOBILE_BRIDGE_MINT_SECRET=seren_local_bridge_mint_dev_only
# EXPO_PUBLIC_MOBILE_BRIDGE_FIREBASE_UID=firebase_uid_a

# FIREBASE CONFIGURATION (existing)
# Keep existing Firebase env vars below:
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=
