# LAN lab mode: phone + Mac on the same Wi‑Fi (no AP/guest isolation).
# Copied/updated automatically by `npm run lab` / `scripts/lab-lan-start.sh`.
# Seren SOS (Seren Tech) — Development — real-guppy-12
#
# Replace LAN_IP before copying manually, or just run: npm run lab
# Open: exp://LAN_IP:8081
#
# For Android USB instead, copy `.env.local.usb` → `.env.local` and use `npm run lab:usb`.
# Avoid Expo --tunnel for bridge testing (tunnel only carries the JS bundle).

EXPO_PUBLIC_ENABLE_CLERK_MOBILE=true
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_seren_sos_real_guppy_12_key

EXPO_PUBLIC_API_BASE_URL=http://LAN_IP:4000
EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=LAN_IP:5001
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=LAN_IP:9099
