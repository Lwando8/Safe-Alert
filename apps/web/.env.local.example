# CLERK CONFIGURATION
# Get these from https://dashboard.clerk.com/ (see docs/PHASE2-CLERK-SETUP-GUIDE.md)

# Required for Next.js
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Sign-in/up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/ops
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/ops

# Organization URLs
NEXT_PUBLIC_CLERK_AFTER_SELECT_ORGANIZATION_URL=/ops
NEXT_PUBLIC_CLERK_AFTER_CREATE_ORGANIZATION_URL=/ops

# FIREBASE CONFIGURATION (existing)
# Keep existing Firebase env vars

# Ops incidents (server) — point Admin SDK at emulators when developing locally
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-seren
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-seren

# Web routes never use Firebase Auth fallback — Clerk session only for /ops and /platform.
# After keys are set, run: cd firebase/functions && npm run preflight:clerk
