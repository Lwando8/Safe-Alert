{
  "name": "safe-alert-sos-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:dashboard": "npm run dev --workspace=@seren/web",
    "build": "npm run build --workspace=@seren/web",
    "domain:build": "npm run build --workspace=@seren/domain",
    "server": "echo \"Local Node server is deprecated for Firebase features; Express SOS regression: cd server && node index.js\"",
    "probe:golden-path": "npm run probe:golden-path --prefix firebase/functions",
    "regress:express-sos": "node scripts/express-sos-regression.js",
    "lab:usb": "bash scripts/lab-usb-start.sh",
    "firebase:emulators": "firebase emulators:start --config firebase/firebase.json",
    "firebase:functions:build": "npm --prefix firebase/functions run build",
    "firebase:functions:serve": "npm --prefix firebase/functions run serve",
    "firebase": "firebase",
    "firebase:login": "firebase login --no-localhost",
    "firebase:deploy:functions": "npm --prefix firebase/functions run deploy -- --project seren-sos",
    "firebase:deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes --config firebase/firebase.json --project seren-sos",
    "firebase:deploy:expansion": "npm run firebase:functions:build && firebase deploy --only functions,firestore:rules,firestore:indexes --config firebase/firebase.json --project seren-sos"
  },
  "dependencies": {
    "@clerk/expo": "^4.2.1",
    "@expo/metro-config": "^54.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/hooks": "^100.1.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "^54.0.21",
    "expo-asset": "~12.0.9",
    "expo-av": "~16.0.7",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.7",
    "expo-media-library": "~18.2.0",
    "expo-notifications": "^0.32.12",
    "expo-secure-store": "~15.0.8",
    "expo-sms": "~14.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.10.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@expo/cli": "^54.0.14",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "~54.0.0",
    "firebase-tools": "^14.5.0",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "utf-8-validate": "^5.0.10"
  }
}
