{
  "name": "safe-alert-firebase-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,database,auth --config ../firebase.json",
    "deploy": "npm run build && firebase deploy --only functions --config ../firebase.json",
    "seed": "npm run build && node lib/scripts/seed.js",
    "seed:phase2b": "npm run build && FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} GCLOUD_PROJECT=${GCLOUD_PROJECT:-demo-seren} node lib/scripts/seed-phase2b-tenants.js",
    "backfill:tenant-profiles": "npm run build && node lib/scripts/backfill-tenant-profiles.js",
    "probe:phase2b": "npm run build && FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} GCLOUD_PROJECT=${GCLOUD_PROJECT:-demo-seren} node lib/scripts/phase2b-emulator-probe.js",
    "probe:phase2d": "npm run build && FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} GCLOUD_PROJECT=${GCLOUD_PROJECT:-demo-seren} node lib/scripts/phase2d-emulator-probe.js",
    "probe:expansion": "npm run build && FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} GCLOUD_PROJECT=${GCLOUD_PROJECT:-demo-seren} node lib/scripts/phase-expansion-emulator-probe.js",
    "preflight:clerk": "npm run build && node lib/scripts/clerk-path-preflight.js",
    "smoke:phase2b": "npm run build && node lib/scripts/phase2b-smoke.js",
    "smoke:phase2b:checklist": "SMOKE_CHECKLIST_ONLY=1 npm run smoke:phase2b"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.13.23",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
