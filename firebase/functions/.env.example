# CLERK CONFIGURATION
# See docs/PHASE2-CLERK-SETUP-GUIDE.md and docs/PHASE2B-MANUAL-VERIFICATION-CHECKLIST.md
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# From Clerk Dashboard → Webhooks → Signing Secret (whsec_...)
# Subscribe: organizationMembership.created/updated/deleted, organization.created/updated
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Phase 2B dual-auth bridge (temporary)
# Default true when unset. Set to false to force Clerk-only on migrated callables.
# Web /ops and /platform never use this fallback — Clerk session only.
ALLOW_FIREBASE_AUTH_FALLBACK=true

# Optional secret for bootstrapOrganizationMemberships without platform operator
MEMBERSHIP_BOOTSTRAP_SECRET=change_me_long_random_secret

# Golden-path / device-lab bridge mint (emulator only — never production)
# Must match EXPO_PUBLIC_MOBILE_BRIDGE_MINT_SECRET on mobile when using operator mint path.
# MOBILE_BRIDGE_MINT_SECRET=seren_local_bridge_mint_dev_only

# FIREBASE ADMIN (existing)
# Keep existing Firebase admin configuration

# Preflight (does not claim verification):
#   npm run preflight:clerk
# Golden path (Firestore emulator):
#   npm run seed:phase2b && npm run probe:golden-path
