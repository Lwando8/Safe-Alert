rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuth() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('DISPATCHER') || hasRole('SUPER_ADMIN');
    }

    // -------------------------------------------------------------------------
    // Phase 2E posture: tenant-sensitive collections are Admin SDK / callable
    // only. Client SDK reads by role alone were cross-tenant (any DISPATCHER /
    // RESPONDER_UNIT could read every org). Ops web uses Admin SDK; migrated
    // incident/push APIs use Cloud Functions. Do not reopen client reads until
    // Clerk org claims (or equivalent) are verified end-to-end.
    // -------------------------------------------------------------------------

    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if false;

      match /emergencyContacts/{contactId} {
        allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
        allow write: if isAuth() && request.auth.uid == uid;
      }

      match /medical/{docId} {
        allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
        allow write: if isAuth() && request.auth.uid == uid;
      }
    }

    // Incidents + timeline — callable / Admin only (tenant stamped server-side)
    match /incidents/{incidentId} {
      allow read, write: if false;

      match /timeline/{eventId} {
        allow read, write: if false;
      }
    }

    // Operations requests / work orders — callable / Admin only
    match /operationalRequests/{requestId} {
      allow read, write: if false;
      match /timeline/{eventId} {
        allow read, write: if false;
      }
    }

    match /workOrders/{workOrderId} {
      allow read, write: if false;
    }

    match /communityGroups/{groupId} {
      allow read, write: if false;
    }

    match /communityEvents/{eventId} {
      allow read, write: if false;
    }

    match /communityAlerts/{alertId} {
      allow read, write: if false;
      match /sightings/{sightingId} {
        allow read, write: if false;
      }
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read, write: if false;
    }

    match /teams/{teamId} {
      allow read, write: if false;
    }

    match /notificationOutbox/{id} {
      allow read, write: if false;
    }

    match /responderUnits/{unitId} {
      allow read, write: if false;
    }

    match /shifts/{shiftId} {
      allow read, write: if false;
    }

    match /operationalDevices/{deviceId} {
      allow read, write: if false;
    }

    // Legacy FCM paths — registration goes through registerPushToken callable
    match /fcmTokens/{uid}/devices/{deviceId} {
      allow read, write: if false;
    }

    // Tenant authority collections — Admin SDK / Cloud Functions only
    match /memberships/{membershipId} {
      allow read, write: if false;
    }

    match /identityLinks/{linkId} {
      allow read, write: if false;
    }

    match /organizations/{orgId} {
      allow read, write: if false;
    }

    match /sites/{siteId} {
      allow read, write: if false;
    }

    match /orgDevices/{orgId}/tokens/{tokenId} {
      allow read, write: if false;
    }

    match /webhookReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Default deny anything else (zones, responders, audit, …)
    // persons / incidentAccessGrants / auditEvents covered by default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
