{
  "name": "@seren/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Shared generic domain types for Seren SOS (Organization, Site, Zone, Membership, Incident scoping).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
